POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
DJANGO_SECRET_KEY=długi_klucz
DJANGO_DEBUG=1
# W dev "*" (IP w sieci LAN się zmienia); na produkcji wpisz konkretne domeny.
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:8081
REDIS_URL=redis://redis:6379/0
# Poczta: lokalnie Mailpit z docker-compose (podgląd wiadomości: http://localhost:8030, port zmienisz przez MAIL_UI_PORT).
# Na produkcji prawdziwy serwer SMTP: EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, EMAIL_USE_TLS=1.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Sklepownia <no-reply@sklepownia.local>
# Aplikacja web, do której prowadzą linki w wiadomościach (zaproszenia do zespołu sklepu).
APP_URL=http://localhost:8081
# Wygeneruj: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Sklepy dostają adresy <slug>.<SHOPS_BASE_DOMAIN>. `localhost` działa tylko na tym komputerze;
# dla telefonu w tej samej sieci wpisz <ip-z-myślnikami>.sslip.io, np. 192-168-33-10.sslip.io.
# Po zmianie: docker compose up -d backend worker && docker compose exec worker python manage.py update_shop_addresses
SHOPS_BASE_DOMAIN=localhost
# Ile sekund trwa każdy krok symulowanego zakładania sklepu
FAKE_PROVISIONER_STEP_DELAY=2
# Klucz kroku, na którym symulacja ma się wysypać (np. install_theme), puste = bez błędu
FAKE_PROVISIONER_FAIL_AT_STEP=
# Jak zakładać sklepy: shops.provisioning.fake.FakeProvisioner (symulacja)
# albo docker (prawdziwe sklepy z infra/shops, WooCommerce i PrestaShop)
SHOP_PROVISIONER=docker
SHOPS_URL_SCHEME=http
# Powiadomienia push na telefony właścicieli: push.senders.expo.ExpoSender (Expo Push)
# albo push.senders.log.LogSender (tylko log workera, do pracy bez telefonu)
PUSH_SENDER=push.senders.expo.ExpoSender
# Tylko gdy projekt Expo ma włączone "Enhanced Security for Push Notifications"
EXPO_ACCESS_TOKEN=
# Co ile minut worker kopiuje nowe i zmienione zamówienia ze sklepów do podsumowania sprzedaży w aplikacji
SHOP_ORDERS_SYNC_MINUTES=15
SHOPS_HTTP_PORT=8080
# "local" pozwala na hasła API przez HTTP; na produkcji "production" i HTTPS
SHOPS_WP_ENVIRONMENT=local
# Poczta sklepów (potwierdzenia zamówień): przekaźnik na serwerze sklepów, bez logowania. Lokalnie Mailpit
# z infra/shops (podgląd: http://localhost:8031). Sklep wysyła jako <slug>@SHOPS_MAIL_DOMAIN (domyślnie
# SHOPS_BASE_DOMAIN), odpowiedzi trafiają na jego adres kontaktowy. Po zmianie: python manage.py configure_shop_mail
# SHOPS_SMTP_HOST=shops-mail
# SHOPS_SMTP_PORT=1025
# SHOPS_MAIL_DOMAIN=
# To samo hasło co w infra/shops/.env
SHOPS_DB_ROOT_PASSWORD=
# Hasło repozytorium kopii zapasowych sklepów (infra/shops/README.md#kopie-zapasowe). Puste = kopie wyłączone.
# Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(32))" i trzymaj kopię hasła poza serwerem:
# bez niego kopii nie da się odczytać.
SHOPS_BACKUP_PASSWORD=
# O której (czas polski) robią się nocne kopie i ile ich zostaje: z ilu ostatnich dni i tygodni po jednej,
# ile dni trzymać ostatnią kopię usuniętego sklepu, ile kopii dziennie właściciel zrobi sam
# SHOPS_BACKUP_HOUR=3
# SHOPS_BACKUP_KEEP_DAILY=7
# SHOPS_BACKUP_KEEP_WEEKLY=4
# SHOPS_BACKUP_DELETED_DAYS=14
# SHOPS_BACKUP_MANUAL_PER_DAY=3
# Monitor sklepów (docs/obsluga.md#monitorowanie): co ile minut sprawdza, po ilu porażkach z rzędu sklep nie działa,
# dokąd idą alarmy obsługi (po przecinku; domyślnie CONTACT_EMAIL), progi dysku i zapełnienia serwera.
# MONITOR_PING_URL: adres pingowany po każdej rundzie (np. Healthchecks.io), alarmuje, gdy rundy ustaną.
# MONITOR_INTERVAL_MINUTES=5
# MONITOR_FAILURES=2
# ALERT_EMAILS=
# MONITOR_DISK_MIN_FREE_PERCENT=10
# MONITOR_SERVER_FULL_PERCENT=90
# MONITOR_PING_URL=
# Płatności: billing.gateways.fake.FakeGateway (symulacja, bez konta) albo billing.gateways.tpay.TpayGateway.
# Klucze Tpay: panel.sandbox.tpay.com (konto testowe: register.sandbox.tpay.com) → Integracja → API.
PAYMENT_GATEWAY=billing.gateways.fake.FakeGateway
TPAY_SANDBOX=1
TPAY_CLIENT_ID=
TPAY_CLIENT_SECRET=
# Kod bezpieczeństwa: panel Tpay → Powiadomienia → Bezpieczeństwo
TPAY_SECURITY_CODE=
# Publiczny adres powiadomień o płatnościach (Tpay nie dotrze do localhost; lokalnie potrzebny tunel)
TPAY_NOTIFICATION_URL=http://localhost:8000/api/billing/notifications/
# Symulacja: 1 = odnowienia planów są odrzucane, żeby sprawdzić nieudane płatności
FAKE_GATEWAY_DECLINE_RENEWALS=0

# Faktury za plany (docs/platnosci.md#faktury): billing.invoicing.platform.PlatformIssuer (numer i PDF tutaj, bez KSeF)
# albo billing.invoicing.fakturownia.FakturowniaIssuer (Fakturownia, faktury dla firm idą do KSeF).
INVOICE_ISSUER=billing.invoicing.platform.PlatformIssuer
# Sprzedawca na fakturach platformy. Puste przy DJANGO_DEBUG=1: dane testowe z dopiskiem na PDF.
INVOICE_SELLER_NAME=
INVOICE_SELLER_TAX_ID=
INVOICE_SELLER_STREET=
INVOICE_SELLER_POSTAL_CODE=
INVOICE_SELLER_CITY=
INVOICE_SELLER_BANK_ACCOUNT=
INVOICE_NUMBER_FORMAT=FV/{year}/{month:02}/{number:04}
# Fakturownia: subdomena konta (firma dla firma.fakturownia.pl) i kod autoryzacyjny API
# (Ustawienia → Ustawienia konta → Integracja). 1 = faktury dla firm wysyłane do KSeF.
FAKTUROWNIA_DOMAIN=
FAKTUROWNIA_API_TOKEN=
FAKTUROWNIA_KSEF=1
