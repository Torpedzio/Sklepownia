POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
DJANGO_SECRET_KEY=długi_klucz
DJANGO_DEBUG=1
# W dev "*" (IP w sieci LAN się zmienia); na produkcji wpisz konkretne domeny.
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:8081
REDIS_URL=redis://redis:6379/0
# Wygeneruj: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Sklepy dostają adresy <slug>.<SHOPS_BASE_DOMAIN>
SHOPS_BASE_DOMAIN=localhost
SHOPS_MAX_PER_USER=3
# Ile sekund trwa każdy krok symulowanego zakładania sklepu
FAKE_PROVISIONER_STEP_DELAY=2
# Klucz kroku, na którym symulacja ma się wysypać (np. install_theme), puste = bez błędu
FAKE_PROVISIONER_FAIL_AT_STEP=
# Jak zakładać sklepy: shops.provisioning.fake.FakeProvisioner (symulacja)
# albo shops.provisioning.docker_provisioner.DockerProvisioner (prawdziwe sklepy z infra/shops)
SHOP_PROVISIONER=shops.provisioning.docker_provisioner.DockerProvisioner
SHOPS_URL_SCHEME=http
SHOPS_HTTP_PORT=8080
# "local" pozwala na hasła API przez HTTP; na produkcji "production" i HTTPS
SHOPS_WP_ENVIRONMENT=local
# To samo hasło co w infra/shops/.env
SHOPS_DB_ROOT_PASSWORD=
