SHOPS_DB_ROOT_PASSWORD=
# Port, na którym działają sklepy (80/443 zajmuje ddev-router)
SHOPS_HTTP_PORT=8080
# Podgląd poczty wysłanej przez sklepy (Mailpit)
SHOPS_MAIL_UI_PORT=8031
SHOPS_DOMAIN=localhost
# Platforma (backend), która pokazuje stronę „Sklep chwilowo niedostępny” pod adresem bez działającego sklepu.
# Lokalnie backend na tym komputerze; na produkcji jego adres widziany z serwera sklepów.
SHOPS_FALLBACK_URL=http://host.docker.internal:8000
