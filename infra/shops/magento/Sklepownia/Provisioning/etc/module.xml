<?xml version="1.0"?>
<!-- What the platform needs inside a shop: one console command for provisioning and settings, local pickup and
     a footer link to the terms. -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Sklepownia_Provisioning">
        <sequence>
            <module name="Magento_Store"/>
            <module name="Magento_Catalog"/>
            <module name="Magento_CatalogInventory"/>
            <module name="Magento_Shipping"/>
            <module name="Magento_OfflineShipping"/>
            <module name="Magento_OfflinePayments"/>
            <module name="Magento_Tax"/>
            <module name="Magento_User"/>
            <module name="Magento_Theme"/>
            <module name="Magento_Cms"/>
            <module name="Magento_CheckoutAgreements"/>
        </sequence>
    </module>
</config>
